{
  "name": "Sea Glass",
  "version": "0.1.0",
  "status": "web-prototype",
  "unit": "logical-px",
  "colour": {
    "seafoam": {
      "pigment": "#97cab5",
      "onMaterial": "#244e40"
    },
    "cornflower": {
      "pigment": "#a2b7e2",
      "onMaterial": "#2b4675"
    },
    "orchid": {
      "pigment": "#d5b1db",
      "onMaterial": "#613b68"
    },
    "honey": {
      "pigment": "#eacb8e",
      "onMaterial": "#6a5122"
    },
    "rose": {
      "pigment": "#e8a89f",
      "onMaterial": "#6c332e"
    },
    "light": {
      "canvas": "#f6f6f0",
      "panel": "#fcfcf8",
      "text": "#273e3a",
      "secondaryText": "#60716b",
      "focus": "#265d53"
    },
    "dark": {
      "canvas": "#182722",
      "panel": "#20352d",
      "text": "#e2ede4",
      "secondaryText": "#a1b3a7",
      "focus": "#a4d6be"
    }
  },
  "spacing": {
    "unit": 4
  },
  "radius": {
    "control": 24,
    "surface": 28,
    "checkbox": 7,
    "badge": 9
  },
  "target": {
    "minimum": 44,
    "standard": 48
  },
  "material": {
    "grainOpacity": 0.32,
    "grainTile": "grain.svg",
    "tileSize": 144,
    "elevationAmount": 0.7,
    "bodyAlpha": 0.92,
    "solidFallback": true,
    "lowerBodyAlpha": 0.88,
    "lowerBorderAlpha": 0.12,
    "lowerEdgeLightAlpha": 0.04
  },
  "elevation": {
    "contact": {
      "y": 2,
      "blur": 3,
      "alpha": 0.08
    },
    "cast": {
      "y": 12,
      "blur": 16,
      "spread": -5,
      "alpha": 0.25
    },
    "pressed": {
      "y": 2,
      "blur": 3,
      "alpha": 0.12
    }
  },
  "motion": {
    "pressMs": 160,
    "pressTravel": 2,
    "reducedMotionTravel": 0,
    "changeMs": 260,
    "expandMs": 340,
    "exitMs": 160,
    "travel": {
      "control": 5,
      "surface": 8,
      "dialog": 12
    },
    "easing": {
      "settle": "cubic-bezier(.22,1,.36,1)",
      "spring": "cubic-bezier(.34,1.3,.64,1)"
    },
    "interruptible": true,
    "reducedMotion": "immediate semantic and visual state; no animation"
  },
  "focus": {
    "width": 2,
    "offset": 4
  },
  "native": {
    "android": "Translate logical px to dp; use native sp typography",
    "ios": "Translate logical px to points; use Dynamic Type",
    "implementation": "future; neither platform is changed by this prototype"
  },
  "slider": {
    "trackHeight": 12,
    "thumbWidth": 44,
    "thumbHeight": 28,
    "targetHeight": 48,
    "thumbRadius": "capsule",
    "activeScale": {
      "x": 1.1,
      "y": 1.06
    },
    "valueMotion": "direct native input; no delayed value or momentum",
    "reducedMotion": "no thumb deformation or transition"
  },
  "fileloom": {
    "scope": "web prototype only",
    "sheet": {
      "maximumWidth": 620,
      "mobileInset": 8,
      "enterTravel": 22,
      "deferUnderlyingRenderUntilClose": true
    },
    "precision": {
      "fontSize": {
        "min": 14,
        "max": 26,
        "step": 1
      },
      "lineHeight": {
        "min": 1.2,
        "max": 2.4,
        "step": 0.1
      },
      "speechRate": {
        "min": 0.5,
        "max": 2,
        "step": 0.1
      }
    },
    "readerSeek": {
      "thumbOnly": true,
      "previewDuringDrag": true,
      "commitOnRelease": true,
      "exactJump": true
    },
    "selection": {
      "persistent": true,
      "pressSeparate": true
    },
    "playback": {
      "movablePreview": true,
      "audioSynthesis": false
    }
  }
}
